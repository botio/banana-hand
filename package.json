{
  "name": "banana-hand",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc --noEmit && vite build",
    "native-host-manifest": "node scripts/write-native-host-manifest.mjs",
    "bundle-native-host": "node scripts/bundle-native-host.mjs",
    "package-chromium-extension": "node scripts/package-chromium-extension.mjs",
    "package-firefox-extension": "node scripts/package-firefox-extension.mjs",
    "sign-firefox-extension": "web-ext sign --channel=unlisted --source-dir=extensions/firefox --artifacts-dir=dist/firefox-extension",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-store": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "^5",
    "vite": "^7",
    "web-ext": "10.6.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
