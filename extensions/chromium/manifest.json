{
  "manifest_version": 3,
  "name": "Banana Hand Browser Bridge",
  "version": "0.1.1",
  "key": "",
  "description": "將目前 Chromium profile 的 Browser Tab 回報給 Banana Hand。",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["tabs", "storage", "nativeMessaging"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
